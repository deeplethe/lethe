# OpenAI-compatible endpoints. Same key works for both if your provider
# (e.g. SiliconFlow) hosts both chat and embeddings.

CHAT_BASE_URL=https://api.siliconflow.cn/v1
CHAT_MODEL=Qwen/Qwen2.5-7B-Instruct
CHAT_API_KEY=sk-...

EMBED_BASE_URL=https://api.siliconflow.cn/v1
EMBED_MODEL=BAAI/bge-m3
EMBED_API_KEY=sk-...
EMBED_DIM=1024
